{
  "name": "viup",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "worker"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,worker -c cyan,magenta \"npm run dev -w @viup/web\" \"npm run dev -w @viup/worker\"",
    "db:generate": "npm run db:generate -w @viup/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "yt:auth": "node packages/publish/src/cli.ts youtube:auth",
    "yt:upload": "node packages/publish/src/cli.ts youtube:upload",
    "app:install": "node apps/web/scripts/install-app.ts",
    "app:uninstall": "node apps/web/scripts/install-app.ts uninstall",
    "daily": "node worker/src/daily.ts",
    "daily:install": "node worker/src/install-timer.ts",
    "daily:uninstall": "node worker/src/install-timer.ts uninstall",
    "tt:auth": "node packages/publish/src/cli.ts tiktok:auth",
    "tt:upload": "node packages/publish/src/cli.ts tiktok:upload",
    "make": "node packages/brain/src/make.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "concurrently": "10.0.6",
    "typescript": "7.0.2"
  }
}
